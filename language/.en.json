    {
      "label": "Textfield",
      "placeholder": "This is an answer: *answer*.",
      "important": {
        "description": "<ul><li>Correct words are marked with asterisks (*) before and after the word.</li><li>Asterisks can be added within marked words by adding another asterisk, *correctword*** =&gt; correctword*.</li><li>Only words may be marked as correct. Not phrases.</li><li>In &quot;Candidates only&quot; selection mode, only words marked with * (correct) or + (distractor) are selectable. Other words stay as plain text. A literal plus is written as ++ inside the marks: +word+++ =&gt; word+.</li></ul>",
        "example": "All words selectable: The *correct* words are marked like this. Candidates only: The *correct* and +wrong+ candidates are clickable; the rest is plain text."
      }
